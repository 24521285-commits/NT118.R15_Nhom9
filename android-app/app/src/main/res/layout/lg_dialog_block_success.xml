<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blockSuccessRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Icon Cấm/Chặn đỏ trong hình tròn hồng -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_circle_pink_check">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Đã chặn người này"
            android:src="@drawable/ic_warning_red" />

    </FrameLayout>

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="Đã chặn người này"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Nội dung mô tả -->
    <TextView
        android:id="@+id/tvBlockSuccessMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Bạn và người này sẽ không còn thấy nhau trên Date Zone. Cuộc trò chuyện đã được ẩn. Bạn có thể bỏ chặn bất cứ lúc nào trong Cài đặt › Danh sách chặn."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <!-- Nút Tiếp tục -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:text="Tiếp tục" />

</LinearLayout>
