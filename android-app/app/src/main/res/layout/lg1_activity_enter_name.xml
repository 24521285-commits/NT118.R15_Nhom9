<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/enterNameRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/auth_screen_padding"
    android:paddingBottom="@dimen/auth_screen_padding">

    <!-- Thanh điều hướng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/AuthBackButton" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1/16"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Tiến trình hoàn thiện hồ sơ -->
    <ProgressBar
        android:id="@+id/progressProfile"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:indeterminate="false"
        android:max="16"
        android:progress="1"
        android:progressBackgroundTint="@color/border_input"
        android:progressTint="@color/brand_primary" />

    <TextView
        style="@style/AuthCardTitle"
        android:layout_marginTop="28dp"
        android:text="Bạn tên là gì?"
        android:textSize="28sp" />

    <TextView
        style="@style/AuthCardSubtitle"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:text="Hãy cho chúng tôi biết tên bạn muốn hiển thị trên hồ sơ." />

    <EditText
        android:id="@+id/edtName"
        style="@style/AuthInputEditText"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:autofillHints="name"
        android:hint="Nhập tên của bạn"
        android:imeOptions="actionDone"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="50"
        android:maxLines="1"
        android:singleLine="true" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:layout_marginTop="28dp"
        android:text="Tiếp tục" />

</LinearLayout>
