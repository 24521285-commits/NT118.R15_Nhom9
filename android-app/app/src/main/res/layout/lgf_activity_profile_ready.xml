<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileReadyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_screen_padding"
    android:paddingTop="24dp"
    android:paddingEnd="@dimen/auth_screen_padding"
    android:paddingBottom="@dimen/auth_screen_padding">

    <!-- Nội dung căn giữa màn hình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Logo Date Zone -->
        <ImageView
            style="@style/AuthLogoImage"
            android:layout_width="64dp"
            android:layout_height="64dp" />

        <TextView
            style="@style/AuthLogoTitle"
            android:layout_marginTop="4dp"
            android:textSize="20sp" />

        <!-- Badge thành công -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Hồ sơ thành công"
            android:src="@drawable/ic_success_badge" />

        <TextView
            style="@style/AuthCardTitle"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Hồ sơ đã sẵn sàng!"
            android:textSize="24sp" />

        <TextView
            style="@style/AuthCardSubtitle"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Hồ sơ của bạn đã được tạo thành công. Hãy bắt đầu khám phá những người phù hợp với bạn." />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:text="Bắt đầu ngay" />

</LinearLayout>
