<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/changeEmailSuccessRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/filters_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Bar Back Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnSuccessBack"
            style="@style/AuthBackButton"
            android:layout_gravity="center_vertical|start" />

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <!-- Logo Date Zone -->
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Date Zone Logo"
                android:src="@drawable/ic_date_zone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Date Zone"
                android:textColor="@color/brand_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Card Đổi email thành công -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="28dp"
                    android:paddingBottom="24dp">

                    <!-- Circle Green Check Icon -->
                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_pink_check"
                        android:backgroundTint="#DCFCE7"
                        android:contentDescription="Thành công"
                        android:padding="16dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="#16A34A" />

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Đổi email thành công"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Subtitle / New Email Note -->
                    <TextView
                        android:id="@+id/tvSuccessEmailNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="Từ giờ bạn sẽ dùng\nminhanh.new@gmail.com để đăng nhập và nhận thông báo."
                        android:textColor="#666668"
                        android:textSize="13sp" />

                    <!-- Button Về trang Cài đặt -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnReturnToSettingsScreen"
                        style="@style/AuthPrimaryButton"
                        android:layout_marginTop="24dp"
                        android:text="Về trang Cài đặt" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
