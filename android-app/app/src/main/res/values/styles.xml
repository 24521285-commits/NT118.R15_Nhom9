<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Top-left Back Button Style -->
    <style name="AuthBackButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/auth_back_button_size</item>
        <item name="android:layout_height">@dimen/auth_back_button_size</item>
        <item name="android:background">@drawable/bg_circle_button</item>
        <item name="android:src">@drawable/ic_back</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:contentDescription">Quay lại</item>
    </style>

    <!-- Logo Image Style -->
    <style name="AuthLogoImage">
        <item name="android:layout_width">@dimen/auth_logo_size</item>
        <item name="android:layout_height">@dimen/auth_logo_size</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:src">@drawable/ic_date_zone</item>
        <item name="android:contentDescription">Logo Date Zone</item>
    </style>

    <!-- Logo Brand Title Style -->
    <style name="AuthLogoTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:text">Date Zone</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textSize">@dimen/font_size_brand</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Auth Card Style -->
    <style name="AuthCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_auth_card</item>
        <item name="android:elevation">@dimen/auth_card_elevation</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/auth_card_padding</item>
    </style>

    <!-- Card Title Style -->
    <style name="AuthCardTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/font_size_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card Subtitle Style -->
    <style name="AuthCardSubtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/font_size_subtitle</item>
    </style>

    <!-- Input Field Label Style -->
    <style name="AuthFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/font_size_label</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Input EditText Style -->
    <style name="AuthInputEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/auth_input_height</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_auth_input</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/font_size_input</item>
    </style>

    <!-- Primary Action Button Style -->
    <style name="AuthPrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/auth_button_height</item>
        <item name="android:background">@drawable/bg_button_continue</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/font_size_button</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Interest Chip Style -->
    <style name="InterestChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">42dp</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipBackgroundColor">@color/selector_chip_background</item>
        <item name="chipStrokeColor">@color/selector_chip_stroke_color</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/selector_chip_text_color</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Relationship Goal RadioButton Option Style -->
    <style name="RelationshipGoalOption" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/n_bg_gender_option</item>
        <item name="android:button">@null</item>
        <item name="android:drawableEnd">@drawable/n_selector_gender_radio</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
