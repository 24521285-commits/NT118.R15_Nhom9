<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/privacySafetyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/filters_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/privacySafetyHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btnPrivacySafetyBack"
            style="@style/AuthBackButton" />
        <TextView
            style="@style/AuthCardTitle"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/profile_home_privacy"
            android:textSize="18sp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_input" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/privacySafetyScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/n_bg_age"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_profile_shield" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/AuthFieldLabel"
                        android:text="@string/privacy_intro_title"
                        android:textSize="14sp" />
                    <TextView
                        style="@style/ProfileEditHint"
                        android:layout_marginTop="5dp"
                        android:text="@string/privacy_intro_summary" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/ProfileSectionTitle"
                android:text="@string/privacy_visibility_title"
                android:textSize="16sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyVisibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:labelFor="@id/switchPrivacyDiscovery"
                                android:text="@string/privacy_discovery"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/privacy_discovery_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPrivacyDiscovery"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:checked="true"
                            android:contentDescription="@string/privacy_discovery"
                            android:splitTrack="false"
                            android:thumb="@drawable/bg_privacy_switch_thumb"
                            app:showText="false"
                            app:switchMinWidth="48dp"
                            app:thumbTint="@null"
                            app:track="@drawable/bg_privacy_switch_track"
                            app:trackTint="@null" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:labelFor="@id/switchPrivacyDistance"
                                android:text="@string/privacy_distance"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/privacy_distance_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPrivacyDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:checked="true"
                            android:contentDescription="@string/privacy_distance"
                            android:splitTrack="false"
                            android:thumb="@drawable/bg_privacy_switch_thumb"
                            app:showText="false"
                            app:switchMinWidth="48dp"
                            app:thumbTint="@null"
                            app:track="@drawable/bg_privacy_switch_track"
                            app:trackTint="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/ProfileEditHint"
                android:layout_marginTop="10dp"
                android:text="@string/privacy_visibility_hint" />
            <TextView
                style="@style/ProfileSectionTitle"
                android:text="@string/privacy_chat_title"
                android:textSize="16sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacyChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:labelFor="@id/switchPrivacyActiveStatus"
                                android:text="@string/privacy_active_status"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/privacy_active_status_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPrivacyActiveStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:checked="false"
                            android:contentDescription="@string/privacy_active_status"
                            android:splitTrack="false"
                            android:thumb="@drawable/bg_privacy_switch_thumb"
                            app:showText="false"
                            app:switchMinWidth="48dp"
                            app:thumbTint="@null"
                            app:track="@drawable/bg_privacy_switch_track"
                            app:trackTint="@null" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:labelFor="@id/switchPrivacyReadReceipts"
                                android:text="@string/privacy_read_receipts"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/privacy_read_receipts_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchPrivacyReadReceipts"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:checked="true"
                            android:contentDescription="@string/privacy_read_receipts"
                            android:splitTrack="false"
                            android:thumb="@drawable/bg_privacy_switch_thumb"
                            app:showText="false"
                            app:switchMinWidth="48dp"
                            app:thumbTint="@null"
                            app:track="@drawable/bg_privacy_switch_track"
                            app:trackTint="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/ProfileSectionTitle"
                android:text="@string/privacy_safety_title"
                android:textSize="16sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivacySafety"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:id="@+id/rowPrivacyBlockedUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_privacy_block" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/privacy_blocked_users"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/privacy_blocked_users_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowPrivacySafeDating"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="60dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_profile_shield" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/privacy_safe_dating"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowPrivacyReport"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="12dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_privacy_report" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/privacy_report"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/privacy_report_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/ProfileEditHint"
                android:layout_marginTop="16dp"
                android:text="@string/privacy_footer" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>