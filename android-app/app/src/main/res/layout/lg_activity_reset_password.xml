<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resetPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/auth_screen_padding">

        <!-- Logo Date Zone -->
        <ImageView
            style="@style/AuthLogoImage"
            android:layout_marginTop="16dp" />

        <TextView
            style="@style/AuthLogoTitle"
            android:layout_marginTop="4dp" />

        <!-- Khung Đặt mật khẩu mới -->
        <LinearLayout
            style="@style/AuthCard"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/AuthCardTitle"
                android:text="Đặt mật khẩu mới" />

            <TextView
                style="@style/AuthCardSubtitle"
                android:text="Tạo mật khẩu mạnh mà bạn chưa từng dùng." />

            <!-- Field 1: Mật khẩu mới -->
            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="20dp"
                android:labelFor="@id/edtNewPassword"
                android:text="Mật khẩu mới" />

            <EditText
                android:id="@+id/edtNewPassword"
                style="@style/AuthInputEditText"
                android:hint="Nhập mật khẩu mới"
                android:inputType="textPassword" />

            <!-- Field 2: Nhập lại mật khẩu -->
            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="16dp"
                android:labelFor="@id/edtConfirmPassword"
                android:text="Nhập lại mật khẩu" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                style="@style/AuthInputEditText"
                android:hint="Nhập lại mật khẩu mới"
                android:inputType="textPassword" />

            <!-- Checklist quy tắc mật khẩu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <!-- Rule 1: Ít nhất 8 ký tự -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRuleMinLength"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Rule check"
                        android:src="@drawable/ic_circle_outline" />

                    <TextView
                        android:id="@+id/tvRuleMinLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Ít nhất 8 ký tự"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_size_caption" />

                </LinearLayout>

                <!-- Rule 2: Có ít nhất một chữ số -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRuleHasDigit"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Rule check"
                        android:src="@drawable/ic_circle_outline" />

                    <TextView
                        android:id="@+id/tvRuleHasDigit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Có ít nhất một chữ số"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_size_caption" />

                </LinearLayout>

                <!-- Rule 3: Trùng khớp với mật khẩu xác nhận -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivRuleMatch"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Rule check"
                        android:src="@drawable/ic_circle_outline" />

                    <TextView
                        android:id="@+id/tvRuleMatch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Trùng khớp với mật khẩu xác nhận"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/font_size_caption" />

                </LinearLayout>

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetPassword"
                style="@style/AuthPrimaryButton"
                android:layout_marginTop="28dp"
                android:text="Đặt lại mật khẩu" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
