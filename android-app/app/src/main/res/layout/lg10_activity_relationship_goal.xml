<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relationshipGoalRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/auth_screen_padding"
    android:paddingBottom="@dimen/auth_screen_padding">

    <!-- Thanh điều hướng và tiến trình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/AuthBackButton" />

        <ProgressBar
            android:id="@+id/progressProfile"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="16"
            android:progress="10"
            android:progressBackgroundTint="@color/border_input"
            android:progressTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10/16"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/AuthCardTitle"
                android:text="Bạn đang tìm kiếm điều gì?"
                android:textSize="28sp" />

            <TextView
                style="@style/AuthCardSubtitle"
                android:layout_marginTop="8dp"
                android:text="Chọn một mục phù hợp nhất." />

            <RadioGroup
                android:id="@+id/rgRelationshipGoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:checkedButton="@id/rbSerious"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbSerious"
                    style="@style/RelationshipGoalOption"
                    android:text="Mối quan hệ nghiêm túc" />

                <RadioButton
                    android:id="@+id/rbLongTerm"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Tìm hiểu để tiến tới mối quan hệ lâu dài" />

                <RadioButton
                    android:id="@+id/rbDating"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Hẹn hò và tìm hiểu" />

                <RadioButton
                    android:id="@+id/rbMarriage"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Kết hôn" />

                <RadioButton
                    android:id="@+id/rbFriendship"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Kết bạn" />

                <RadioButton
                    android:id="@+id/rbMeetPeople"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Gặp gỡ và kết nối người mới" />

                <RadioButton
                    android:id="@+id/rbCasual"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Mối quan hệ không ràng buộc" />

                <RadioButton
                    android:id="@+id/rbUnsure"
                    style="@style/RelationshipGoalOption"
                    android:layout_marginTop="10dp"
                    android:text="Chưa xác định, cứ tìm hiểu trước" />

            </RadioGroup>

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:layout_marginTop="16dp"
        android:text="Tiếp tục" />

</LinearLayout>
