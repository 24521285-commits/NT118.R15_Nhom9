<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/discoveryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Header top bar -->
    <LinearLayout
        android:id="@+id/discoveryHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Logo Date Zone"
                android:src="@drawable/ic_date_zone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Date Zone"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDiscoveryFilters"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/discovery_filters"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_discovery_filters"
            app:tint="@color/brand_primary" />

    </LinearLayout>

    <!-- Khung chứa các thẻ hồ sơ xếp chồng (Card Stack) -->
    <FrameLayout
        android:id="@+id/cardStackContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/discoveryActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/discoveryHeader">

        <!-- THẺ PHÍA SAU (Background Card) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDiscoveryProfileBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleX="0.95"
            android:scaleY="0.95"
            android:translationY="12dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiscoveryPhotoBg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/discovery_profile_photo"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@id/discoveryProfileInfoBg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/discovery_profile_placeholder" />

                <LinearLayout
                    android:id="@+id/discoveryProfileInfoBg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDiscoveryNameBg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Nguyễn Minh Anh"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiscoveryAgeBg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="25 tuổi"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiscoveryDetailsBg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chiều cao 165 cm  Cân nặng 55 kg  Giới tính Nữ"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDiscoveryDistanceBg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="Cách bạn 1,2 km"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/n_ic_location" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- THẺ TRÊN CÙNG (Top Card - Nhận thao tác vuốt/kéo tự do trên toàn màn hình) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDiscoveryProfileTop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:cardPreventCornerOverlap="false">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Ảnh hồ sơ -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivDiscoveryPhoto"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:contentDescription="@string/discovery_profile_photo"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toTopOf="@id/discoveryProfileInfo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/discovery_profile_placeholder" />

                <!-- Chấm chỉ báo danh sách ảnh -->
                <LinearLayout
                    android:id="@+id/discoveryPhotoIndicators"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="@id/ivDiscoveryPhoto"
                    app:layout_constraintStart_toStartOf="@id/ivDiscoveryPhoto"
                    app:layout_constraintTop_toTopOf="@id/ivDiscoveryPhoto">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_circle_add" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_circle_remove"
                        android:backgroundTint="@color/discovery_muted" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_circle_remove"
                        android:backgroundTint="@color/discovery_muted" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_circle_remove"
                        android:backgroundTint="@color/discovery_muted" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_circle_remove"
                        android:backgroundTint="@color/discovery_muted" />

                </LinearLayout>

                <!-- Thông tin người dùng -->
                <LinearLayout
                    android:id="@+id/discoveryProfileInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:paddingEnd="40dp">

                        <TextView
                            android:id="@+id/tvDiscoveryName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Trương Vĩnh Nguyên"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiscoveryAge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="20 tuổi"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiscoveryDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chiều cao 170 cm  Cân nặng 65 kg  Giới tính Nam"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvDiscoveryDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:text="Cách bạn 1,2 km"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/n_ic_location" />

                </LinearLayout>

                <!-- Nút Mở rộng xem chi tiết hồ sơ -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btnDiscoveryProfileDetails"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_circle_add"
                    android:contentDescription="@string/discovery_profile_details"
                    android:elevation="4dp"
                    android:padding="10dp"
                    app:layout_constraintBottom_toBottomOf="@id/ivDiscoveryPhoto"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ivDiscoveryPhoto"
                    app:srcCompat="@drawable/ic_discovery_arrow_up"
                    app:tint="@color/white" />

                <!-- OVERLAY BADGES KHI KÉO/QUẸT -->

                <!-- Badges Quẹt Trái (Pass X) -->
                <ImageView
                    android:id="@+id/ivPassOverlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="24dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Bỏ qua"
                    android:elevation="8dp"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_remove"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/discovery_pass_orange" />

                <!-- Badges Quẹt Phải (Like Heart) -->
                <ImageView
                    android:id="@+id/ivLikeOverlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_margin="24dp"
                    android:background="@drawable/bg_circle_button"
                    android:contentDescription="Thích"
                    android:elevation="8dp"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_discovery_heart"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/brand_primary" />

                <!-- Badges Quẹt Lên (Super Like Star) -->
                <ImageView
                    android:id="@+id/ivSuperLikeOverlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_circle_purple"
                    android:contentDescription="Siêu thích"
                    android:elevation="8dp"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_discovery_star"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Nút Thao tác bên dưới (Pass X, Like Heart, Super Like Star) -->
    <LinearLayout
        android:id="@+id/discoveryActions"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginHorizontal="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/discoveryBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Nút Pass X -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDiscoveryPass"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/discovery_pass"
            android:elevation="4dp"
            android:padding="16dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_remove"
            app:tint="@color/discovery_pass_orange" />

        <!-- Nút Like Heart -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDiscoveryLike"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/bg_circle_add"
            android:contentDescription="@string/discovery_like"
            android:elevation="8dp"
            android:padding="18dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_discovery_heart"
            app:tint="@color/white" />

        <!-- Nút Super Like Star -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnDiscoverySuperLike"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/discovery_super_like"
            android:elevation="4dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/ic_discovery_star"
            app:tint="@color/discovery_star_purple" />

    </LinearLayout>

    <!-- Thanh điều hướng Bottom Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/discoveryBottomNavigation"
        style="@style/AppBottomNavigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/discovery_bottom_navigation"
        tools:menu="@menu/discovery_bottom_navigation" />

</androidx.constraintlayout.widget.ConstraintLayout>
