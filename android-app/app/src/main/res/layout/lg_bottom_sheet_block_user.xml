<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_top"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- Thanh gạt kéo ở đỉnh Bottom Sheet -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_circle_remove"
        android:backgroundTint="#CBD5E1" />

    <!-- Icon Cấm/Chặn màu đỏ trong hình tròn hồng -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle_pink_check">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="Chặn người này"
            android:src="@drawable/ic_warning_red" />

    </FrameLayout>

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Chặn người này?"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Dòng nội dung chi tiết -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="Người này sẽ không thể thấy hồ sơ hay nhắn tin cho bạn nữa, và sẽ biến mất khỏi danh sách tương hợp.\nBạn có thể bỏ chặn trong Cài đặt."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Nút Chặn (Đỏ) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnConfirmBlock"
        style="@style/AuthPrimaryButton"
        android:layout_marginTop="20dp"
        android:text="Chặn" />

    <!-- Nút Hủy (Khung xám/trắng) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancelBlock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/auth_button_height"
        android:layout_marginTop="12dp"
        android:background="@drawable/n_bg_gender_option"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/font_size_button"
        android:textStyle="bold"
        android:text="Hủy" />

</LinearLayout>
