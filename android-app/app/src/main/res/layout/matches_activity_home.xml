<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/matchesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:theme="@style/Theme.DateZone">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/matchesScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/matchesBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="40dp"
            android:paddingEnd="32dp"
            android:paddingBottom="8dp">
            <TextView
                android:id="@+id/tvMatchesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:accessibilityHeading="true"
                android:text="@string/matches_title"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvMatchesSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/matches_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View style="@style/MatchesDivider" />
                    <TextView style="@style/MatchesDay" android:text="@string/matches_today" />
                    <View style="@style/MatchesDivider" />
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/matchesGuideSoi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMatchSoi"
                        style="@style/MatchesCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintDimensionRatio="H,7:10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/matchesGuideSoi">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <!-- Replace this sample drawable with the corresponding profile photo. -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMatchSoi"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/discovery_profile_placeholder" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_matches_scrim"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMatchSoi"
                                    style="@style/MatchesName"
                                    android:text="@string/matches_sample_soi" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="#26FFFFFF"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchPassSoi"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_pass"
                                        app:srcCompat="@drawable/ic_remove" />
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:background="#80FFFFFF"
                                        android:importantForAccessibility="no" />
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchLikeSoi"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_like"
                                        app:srcCompat="@drawable/ic_discovery_heart" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMatchNguyen"
                        style="@style/MatchesCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="24dp"
                        app:layout_constraintDimensionRatio="H,7:10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/matchesGuideSoi"
                        app:layout_constraintEnd_toEndOf="parent">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <!-- Replace this sample drawable with the corresponding profile photo. -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMatchNguyen"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/discovery_profile_placeholder" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_matches_scrim"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMatchNguyen"
                                    style="@style/MatchesName"
                                    android:text="@string/matches_sample_nguyen" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="#26FFFFFF"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchPassNguyen"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_pass"
                                        app:srcCompat="@drawable/ic_remove" />
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:background="#80FFFFFF"
                                        android:importantForAccessibility="no" />
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchLikeNguyen"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_like"
                                        app:srcCompat="@drawable/ic_discovery_heart" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/matchesGuideNguu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMatchNguu"
                        style="@style/MatchesCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintDimensionRatio="H,7:10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/matchesGuideNguu">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <!-- Replace this sample drawable with the corresponding profile photo. -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMatchNguu"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/discovery_profile_placeholder" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_matches_scrim"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMatchNguu"
                                    style="@style/MatchesName"
                                    android:text="@string/matches_sample_nguu" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="#26FFFFFF"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchPassNguu"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_pass"
                                        app:srcCompat="@drawable/ic_remove" />
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:background="#80FFFFFF"
                                        android:importantForAccessibility="no" />
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchLikeNguu"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_like"
                                        app:srcCompat="@drawable/ic_discovery_heart" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMatchHadley"
                        style="@style/MatchesCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="24dp"
                        app:layout_constraintDimensionRatio="H,7:10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/matchesGuideNguu"
                        app:layout_constraintEnd_toEndOf="parent">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <!-- Replace this sample drawable with the corresponding profile photo. -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMatchHadley"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/discovery_profile_placeholder" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_matches_scrim"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMatchHadley"
                                    style="@style/MatchesName"
                                    android:text="@string/matches_sample_hadley" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="#26FFFFFF"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchPassHadley"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_pass"
                                        app:srcCompat="@drawable/ic_remove" />
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:background="#80FFFFFF"
                                        android:importantForAccessibility="no" />
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchLikeHadley"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_like"
                                        app:srcCompat="@drawable/ic_discovery_heart" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View style="@style/MatchesDivider" />
                    <TextView style="@style/MatchesDay" android:text="@string/matches_yesterday" />
                    <View style="@style/MatchesDivider" />
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">
                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/matchesGuideKyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMatchKyle"
                        style="@style/MatchesCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginEnd="24dp"
                        app:layout_constraintDimensionRatio="H,7:10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/matchesGuideKyle">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <!-- Replace this sample drawable with the corresponding profile photo. -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMatchKyle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/discovery_profile_placeholder" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_matches_scrim"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMatchKyle"
                                    style="@style/MatchesName"
                                    android:text="@string/matches_sample_kyle" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="#26FFFFFF"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchPassKyle"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_pass"
                                        app:srcCompat="@drawable/ic_remove" />
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:background="#80FFFFFF"
                                        android:importantForAccessibility="no" />
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchLikeKyle"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_like"
                                        app:srcCompat="@drawable/ic_discovery_heart" />
                                </LinearLayout>
                            </LinearLayout>
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardMatchLisa"
                        style="@style/MatchesCard"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="24dp"
                        app:layout_constraintDimensionRatio="H,7:10"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toEndOf="@id/matchesGuideKyle"
                        app:layout_constraintEnd_toEndOf="parent">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <!-- Replace this sample drawable with the corresponding profile photo. -->
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivMatchLisa"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/discovery_profile_placeholder" />
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/bg_matches_scrim"
                                android:importantForAccessibility="no" />
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvMatchLisa"
                                    style="@style/MatchesName"
                                    android:text="@string/matches_sample_lisa" />
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="#26FFFFFF"
                                    android:orientation="horizontal">
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchPassLisa"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_pass"
                                        app:srcCompat="@drawable/ic_remove" />
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="match_parent"
                                        android:background="#80FFFFFF"
                                        android:importantForAccessibility="no" />
                                    <androidx.appcompat.widget.AppCompatImageButton
                                        android:id="@+id/btnMatchLikeLisa"
                                        style="@style/MatchesAction"
                                        android:contentDescription="@string/discovery_like"
                                        app:srcCompat="@drawable/ic_discovery_heart" />
                                </LinearLayout>
                            </LinearLayout>
                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="8dp"
                                android:background="@drawable/bg_circle_button"
                                android:contentDescription="@string/matches_badge"
                                android:padding="8dp"
                                app:srcCompat="@drawable/ic_discovery_heart"
                                app:tint="@color/brand_primary" />
                        </FrameLayout>
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/matchesBottomNavigation"
        style="@style/AppBottomNavigation"
        app:menu="@menu/matches_bottom_navigation"
        tools:menu="@menu/matches_bottom_navigation"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
