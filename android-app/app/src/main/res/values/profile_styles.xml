<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ProfileSectionTitle" parent="AuthFieldLabel">
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="ProfileInterestTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:background">@drawable/bg_auth_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawablePadding">6dp</item>
    </style>
    <style name="ProfileInterestTagSelected" parent="ProfileInterestTag">
        <item name="android:background">@drawable/bg_profile_interest_selected</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>
    <style name="ProfileGalleryCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardPreventCornerOverlap">false</item>
    </style>
    <style name="ProfileGalleryImage">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/discovery_profile_placeholder</item>
    </style>
</resources>
