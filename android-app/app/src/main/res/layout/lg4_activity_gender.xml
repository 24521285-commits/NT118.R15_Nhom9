<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/genderRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/auth_screen_padding"
    android:paddingBottom="@dimen/auth_screen_padding">

    <!-- Thanh điều hướng và tiến trình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/AuthBackButton" />

        <ProgressBar
            android:id="@+id/progressProfile"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="16"
            android:progress="4"
            android:progressBackgroundTint="@color/border_input"
            android:progressTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4/16"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/AuthCardTitle"
                android:text="Giới tính của bạn"
                android:textSize="28sp" />

            <TextView
                style="@style/AuthCardSubtitle"
                android:layout_marginTop="8dp"
                android:text="Chọn giới tính phù hợp với bạn." />

            <!-- Chọn giới tính (Nam, Nữ, Phi nhị nguyên) -->
            <RadioGroup
                android:id="@+id/rgGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:checkedButton="@id/rbFemale"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/n_bg_gender_option"
                    android:button="@null"
                    android:drawableEnd="@drawable/n_selector_gender_radio"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Nam"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/n_bg_gender_option"
                    android:button="@null"
                    android:drawableEnd="@drawable/n_selector_gender_radio"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Nữ"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbNonBinary"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/n_bg_gender_option"
                    android:button="@null"
                    android:drawableEnd="@drawable/n_selector_gender_radio"
                    android:drawablePadding="12dp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Phi nhị nguyên"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Bạn có thể thay đổi thông tin này sau."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Công tắc Bật/Tắt hiển thị giới tính -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchShowGender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:checked="true"
                android:text="Hiển thị giới tính trên hồ sơ"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:thumbTint="@color/white"
                app:trackTint="@color/brand_primary" />

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:layout_marginTop="20dp"
        android:text="Tiếp tục" />

</LinearLayout>
