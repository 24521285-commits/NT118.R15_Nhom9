<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filtersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/filters_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/filtersHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFiltersClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/filters_close"
            android:padding="16dp"
            app:srcCompat="@drawable/ic_remove"
            app:tint="@color/text_primary" />
        <TextView
            style="@style/AuthCardTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/filters_title"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/btnFiltersContinue"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="@string/filters_continue"
            android:textColor="@color/brand_primary"
            android:textSize="14sp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_input" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/filtersScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFiltersBasic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_add"
                            android:backgroundTint="@color/filters_background"
                            android:gravity="center"
                            android:text="@string/filters_step_one"
                            android:textColor="@color/brand_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_basic_title"
                                android:textSize="17sp" />
                            <TextView
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_basic_subtitle"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        style="@style/FiltersFieldLabel"
                        android:text="@string/filters_gender" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupFiltersGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnFiltersWomen">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltersWomen"
                            style="@style/FiltersGenderButton"
                            android:text="@string/filters_women" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltersMen"
                            style="@style/FiltersGenderButton"
                            android:text="@string/filters_men" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFiltersEveryone"
                            style="@style/FiltersGenderButton"
                            android:text="@string/filters_everyone" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <TextView
                        style="@style/FiltersFieldLabel"
                        android:text="@string/filters_orientation" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupFiltersOrientation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersStraight"
                            style="@style/FiltersChoiceChip"
                            android:checked="true"
                            android:text="@string/filters_straight" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersGay"
                            style="@style/FiltersChoiceChip"
                            android:checked="false"
                            android:text="@string/filters_gay" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersBisexual"
                            style="@style/FiltersChoiceChip"
                            android:checked="false"
                            android:text="@string/filters_bisexual" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersAnyOrientation"
                            style="@style/FiltersChoiceChip"
                            android:checked="false"
                            android:text="@string/filters_everyone" />
                    </com.google.android.material.chip.ChipGroup>
                    <TextView
                        style="@style/FiltersFieldLabel"
                        android:text="@string/filters_location" />
                    <LinearLayout
                        android:id="@+id/btnFiltersLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/n_bg_birthday"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/tvFiltersLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filters_location_value"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/AuthFieldLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_distance" />
                        <TextView
                            android:id="@+id/tvFiltersDistanceValue"
                            style="@style/FiltersRangeValue"
                            android:text="@string/filters_distance_value" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderFiltersDistance"
                        style="@style/FiltersSlider"
                        android:contentDescription="@string/filters_distance"
                        android:valueFrom="1"
                        android:valueTo="100"
                        android:stepSize="1"
                        android:value="40" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_distance_min" />
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:text="@string/filters_distance_max" />
                    </LinearLayout>
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/groupFiltersDistancePresets"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="4dp"
                        app:singleSelection="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersDistance5"
                            style="@style/FiltersChoiceChip"
                            android:checked="false"
                            android:text="@string/filters_distance_5" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersDistance10"
                            style="@style/FiltersChoiceChip"
                            android:checked="false"
                            android:text="@string/filters_distance_10" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersSameDistrict"
                            style="@style/FiltersChoiceChip"
                            android:checked="false"
                            android:text="@string/filters_same_district" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFiltersSameCity"
                            style="@style/FiltersChoiceChip"
                            android:checked="true"
                            android:text="@string/filters_same_city" />
                    </com.google.android.material.chip.ChipGroup>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/AuthFieldLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_age" />
                        <TextView
                            android:id="@+id/tvFiltersAgeValue"
                            style="@style/FiltersRangeValue"
                            android:text="@string/filters_age_value" />
                    </LinearLayout>
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/sliderFiltersAge"
                        style="@style/FiltersSlider"
                        android:contentDescription="@string/filters_age"
                        android:valueFrom="18"
                        android:valueTo="60"
                        android:stepSize="1"
                        app:values="@array/filters_age_initial_values" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_age_min" />
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:text="@string/filters_age_max" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFiltersAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_add"
                            android:backgroundTint="@color/filters_background"
                            android:gravity="center"
                            android:text="@string/filters_step_two"
                            android:textColor="@color/brand_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_advanced_title"
                                android:textSize="17sp" />
                            <TextView
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_advanced_subtitle"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/AuthFieldLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_height" />
                        <TextView
                            android:id="@+id/tvFiltersHeightValue"
                            style="@style/FiltersRangeValue"
                            android:text="@string/filters_height_value" />
                    </LinearLayout>
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/sliderFiltersHeight"
                        style="@style/FiltersSlider"
                        android:contentDescription="@string/filters_height"
                        android:valueFrom="140"
                        android:valueTo="200"
                        android:stepSize="1"
                        app:values="@array/filters_height_initial_values" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_height_min" />
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:text="@string/filters_height_max" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/AuthFieldLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_weight" />
                        <TextView
                            android:id="@+id/tvFiltersWeightValue"
                            style="@style/FiltersRangeValue"
                            android:text="@string/filters_weight_value" />
                    </LinearLayout>
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/sliderFiltersWeight"
                        style="@style/FiltersSlider"
                        android:contentDescription="@string/filters_weight"
                        android:valueFrom="35"
                        android:valueTo="120"
                        android:stepSize="1"
                        app:values="@array/filters_weight_initial_values" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_weight_min" />
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:text="@string/filters_weight_max" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersInterests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_interests" />
                            <TextView
                                android:id="@+id/tvFiltersInterestsSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_interests_value"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersRelationship"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_relationship" />
                            <TextView
                                android:id="@+id/tvFiltersRelationshipSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_relationship_value"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersZodiac"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_zodiac" />
                            <TextView
                                android:id="@+id/tvFiltersZodiacSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_any"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersSmoking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_smoking" />
                            <TextView
                                android:id="@+id/tvFiltersSmokingSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_smoking_value"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersDrinking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_drinking" />
                            <TextView
                                android:id="@+id/tvFiltersDrinkingSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_drinking_value"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersExercise"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_exercise" />
                            <TextView
                                android:id="@+id/tvFiltersExerciseSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_exercise_value"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowFiltersEducation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/filters_education" />
                            <TextView
                                android:id="@+id/tvFiltersEducationSummary"
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="3dp"
                                android:text="@string/filters_education_value"
                                android:textColor="@color/brand_primary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filters_expand" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:id="@+id/filtersFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltersReset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:text="@string/filters_reset"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            app:cornerRadius="26dp"
            app:strokeColor="@color/brand_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFiltersApply"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.6"
            android:text="@string/filters_apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="26dp" />
    </LinearLayout>
</LinearLayout>