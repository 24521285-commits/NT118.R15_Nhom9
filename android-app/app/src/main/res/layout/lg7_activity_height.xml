<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/heightRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/auth_screen_padding"
    android:paddingBottom="@dimen/auth_screen_padding">

    <!-- Thanh điều hướng và tiến trình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/AuthBackButton" />

        <ProgressBar
            android:id="@+id/progressProfile"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="16"
            android:progress="7"
            android:progressBackgroundTint="@color/border_input"
            android:progressTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="7/16"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Khung chứa nội dung chính căn trung tâm màn hình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/AuthCardTitle"
            android:text="Chiều cao của bạn?"
            android:textSize="28sp" />

        <TextView
            style="@style/AuthCardSubtitle"
            android:layout_marginTop="8dp"
            android:text="Kéo thanh trượt để chọn chiều cao." />

        <!-- Đẩy nội dung chính vào giữa màn hình -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.8" />

        <!-- Hiển thị Giá trị chiều cao "172 cm" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="172"
                android:textColor="@color/brand_primary"
                android:textSize="64sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="cm"
                android:textColor="@color/text_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Thanh trượt chọn chiều cao (140 - 200 cm) -->
        <SeekBar
            android:id="@+id/seekHeight"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:contentDescription="Chiều cao từ 140 đến 200 cm"
            android:max="60"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:progress="32"
            android:progressBackgroundTint="@color/border_input"
            android:progressTint="@color/brand_primary"
            android:splitTrack="false"
            android:thumbTint="@color/brand_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="140 cm"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="200 cm"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Spacer phía dưới -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.2" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:text="Tiếp tục" />

</LinearLayout>
