<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/zodiacRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    android:paddingStart="@dimen/auth_screen_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/auth_screen_padding"
    android:paddingBottom="@dimen/auth_screen_padding">

    <!-- Thanh điều hướng và tiến trình -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/AuthBackButton" />

        <ProgressBar
            android:id="@+id/progressProfile"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:indeterminate="false"
            android:max="16"
            android:progress="11"
            android:progressBackgroundTint="@color/border_input"
            android:progressTint="@color/brand_primary" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11/16"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/AuthCardTitle"
                android:text="Cung hoàng đạo của bạn?"
                android:textSize="28sp" />

            <TextView
                style="@style/AuthCardSubtitle"
                android:layout_marginTop="8dp"
                android:text="Chọn một cung." />

            <!-- Danh sách Cung hoàng đạo -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupZodiac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp"
                app:selectionRequired="false"
                app:singleLine="false"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAries"
                    style="@style/InterestChip"
                    android:text="Bạch Dương"
                    app:chipIcon="@drawable/ic_zodiac_aries"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTaurus"
                    style="@style/InterestChip"
                    android:text="Kim Ngưu"
                    app:chipIcon="@drawable/ic_zodiac_taurus"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGemini"
                    style="@style/InterestChip"
                    android:text="Song Tử"
                    app:chipIcon="@drawable/ic_zodiac_gemini"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCancer"
                    style="@style/InterestChip"
                    android:text="Cự Giải"
                    app:chipIcon="@drawable/ic_zodiac_cancer"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLeo"
                    style="@style/InterestChip"
                    android:text="Sư Tử"
                    app:chipIcon="@drawable/ic_zodiac_leo"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVirgo"
                    style="@style/InterestChip"
                    android:text="Xử Nữ"
                    app:chipIcon="@drawable/ic_zodiac_virgo"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLibra"
                    style="@style/InterestChip"
                    android:text="Thiên Bình"
                    app:chipIcon="@drawable/ic_zodiac_libra"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipScorpio"
                    style="@style/InterestChip"
                    android:text="Bọ Cạp"
                    app:chipIcon="@drawable/ic_zodiac_scorpio"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSagittarius"
                    style="@style/InterestChip"
                    android:text="Nhân Mã"
                    app:chipIcon="@drawable/ic_zodiac_sagittarius"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCapricorn"
                    style="@style/InterestChip"
                    android:text="Ma Kết"
                    app:chipIcon="@drawable/ic_zodiac_capricorn"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAquarius"
                    style="@style/InterestChip"
                    android:text="Bảo Bình"
                    app:chipIcon="@drawable/ic_zodiac_aquarius"
                    app:chipIconVisible="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPisces"
                    style="@style/InterestChip"
                    android:text="Song Ngư"
                    app:chipIcon="@drawable/ic_zodiac_pisces"
                    app:chipIconVisible="true" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnContinue"
        style="@style/AuthPrimaryButton"
        android:layout_marginTop="16dp"
        android:text="Tiếp tục" />

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Bỏ qua bước này"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
