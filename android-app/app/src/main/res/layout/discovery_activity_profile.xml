<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profileDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/profileDetailHeader"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnProfileBack"
            style="@style/AuthBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/brand_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/profile_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                style="@style/AuthLogoImage"
                android:layout_width="36dp"
                android:layout_height="36dp" />

            <TextView
                style="@style/AuthLogoTitle"
                android:layout_width="wrap_content"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Native scrolling works without adding a Java controller. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileDetailScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Bind the real profile photo here when profile data is available. -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivProfileCover"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:contentDescription="@string/discovery_profile_photo"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/discovery_profile_placeholder" />

            <LinearLayout
                android:id="@+id/profileDetailContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-24dp"
                android:background="@drawable/bg_auth_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvProfileNameAge"
                    style="@style/AuthCardTitle"
                    android:text="@string/profile_sample_name_age"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/tvProfileGender"
                    style="@style/AuthCardSubtitle"
                    android:layout_marginTop="4dp"
                    android:text="@string/profile_sample_gender"
                    android:textSize="13sp" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/tvProfileLocationTitle"
                        style="@style/ProfileSectionTitle"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:text="@string/profile_location_title"
                        app:layout_constraintEnd_toStartOf="@id/btnProfileLike"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvProfileLocation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="12dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/profile_sample_location"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnProfileLike"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvProfileLocationTitle" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnProfileLike"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:minWidth="76dp"
                        android:minHeight="48dp"
                        android:background="@drawable/n_bg_age"
                        android:paddingHorizontal="12dp"
                        android:drawablePadding="6dp"
                        android:text="@string/profile_like"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp"
                        app:drawableStartCompat="@drawable/ic_discovery_heart"
                        app:drawableTint="@color/brand_primary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/profile_about_title" />

                <TextView
                    android:id="@+id/tvProfileBio"
                    style="@style/AuthCardSubtitle"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/profile_sample_bio" />

                <TextView
                    style="@style/ProfileSectionTitle"
                    android:text="@string/profile_interests_title" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tagProfileMusic"
                        style="@style/ProfileInterestTagSelected"
                        android:text="@string/profile_interest_music"
                        app:drawableStartCompat="@drawable/ic_profile_music" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tagProfileGaming"
                        style="@style/ProfileInterestTagSelected"
                        android:text="@string/profile_interest_gaming"
                        app:drawableStartCompat="@drawable/ic_profile_game" />

                    <TextView
                        android:id="@+id/tagProfileTravel"
                        style="@style/ProfileInterestTag"
                        android:text="@string/profile_interest_travel" />

                    <TextView
                        android:id="@+id/tagProfileReading"
                        style="@style/ProfileInterestTag"
                        android:text="@string/profile_interest_reading" />

                    <TextView
                        android:id="@+id/tagProfileBadminton"
                        style="@style/ProfileInterestTag"
                        android:text="@string/profile_interest_badminton" />

                    <androidx.constraintlayout.helper.widget.Flow
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:constraint_referenced_ids="tagProfileMusic,tagProfileGaming,tagProfileTravel,tagProfileReading,tagProfileBadminton"
                        app:flow_horizontalBias="0"
                        app:flow_horizontalGap="8dp"
                        app:flow_horizontalStyle="packed"
                        app:flow_verticalAlign="center"
                        app:flow_verticalGap="8dp"
                        app:flow_wrapMode="chain"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/ProfileSectionTitle"
                        android:layout_width="0dp"
                        android:layout_marginTop="0dp"
                        android:layout_weight="1"
                        android:text="@string/profile_gallery_title" />

                    <TextView
                        android:id="@+id/btnProfileViewAllPhotos"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="@string/profile_view_all"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/profilePhotoGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/profileGalleryCenter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <androidx.cardview.widget.CardView
                        style="@style/ProfileGalleryCard"
                        android:id="@+id/profileGalleryCard1"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto1"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="@string/profile_gallery_photo_1" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        style="@style/ProfileGalleryCard"
                        android:id="@+id/profileGalleryCard2"
                        android:layout_marginStart="4dp"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto2"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="@string/profile_gallery_photo_2" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        style="@style/ProfileGalleryCard"
                        android:id="@+id/profileGalleryCard3"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="4dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/profileGalleryCard1">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto3"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="@string/profile_gallery_photo_3" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        style="@style/ProfileGalleryCard"
                        android:id="@+id/profileGalleryCard4"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="1:1"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/profileGalleryCenter"
                        app:layout_constraintTop_toBottomOf="@id/profileGalleryCard2">

                        <ImageView
                            android:id="@+id/ivProfileGalleryPhoto4"
                            style="@style/ProfileGalleryImage"
                            android:contentDescription="@string/profile_gallery_photo_4" />
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
