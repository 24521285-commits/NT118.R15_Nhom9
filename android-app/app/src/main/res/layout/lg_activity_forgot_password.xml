<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forgotPasswordRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/auth_screen_padding">

        <!-- Nút quay lại top-left -->
        <ImageButton
            android:id="@+id/btnBack"
            style="@style/AuthBackButton"
            android:layout_marginTop="8dp" />

        <!-- Logo Date Zone -->
        <ImageView
            style="@style/AuthLogoImage"
            android:layout_marginTop="8dp" />

        <TextView
            style="@style/AuthLogoTitle"
            android:layout_marginTop="4dp" />

        <!-- Khung Quên mật khẩu -->
        <LinearLayout
            style="@style/AuthCard"
            android:layout_marginTop="24dp">

            <TextView
                style="@style/AuthCardTitle"
                android:text="Quên mật khẩu?" />

            <TextView
                style="@style/AuthCardSubtitle"
                android:lineSpacingExtra="2dp"
                android:text="Nhập số điện thoại, chúng tôi sẽ gửi mã gồm 6 chữ số để bạn đặt lại mật khẩu." />

            <TextView
                style="@style/AuthFieldLabel"
                android:layout_marginTop="20dp"
                android:labelFor="@id/edtPhone"
                android:text="Số điện thoại" />

            <EditText
                android:id="@+id/edtPhone"
                style="@style/AuthInputEditText"
                android:hint="+84 ••• ••• •••"
                android:inputType="phone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSendOtp"
                style="@style/AuthPrimaryButton"
                android:layout_marginTop="28dp"
                android:text="Gửi mã OTP" />

        </LinearLayout>

        <!-- Quay lại đăng nhập link -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhớ mật khẩu rồi? "
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/font_size_subtitle" />

            <TextView
                android:id="@+id/tvBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="Quay lại đăng nhập"
                android:textColor="@color/text_link_blue"
                android:textSize="@dimen/font_size_subtitle"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
