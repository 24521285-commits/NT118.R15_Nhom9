<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/myProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/filters_background"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:id="@+id/myProfileHeader"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            style="@style/AuthCardTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/profile_home_title"
            android:textSize="22sp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                style="@style/AuthLogoImage"
                android:layout_width="36dp"
                android:layout_height="36dp" />
            <TextView
                style="@style/AuthLogoTitle"
                android:layout_width="wrap_content"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/myProfileScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/myProfileHeader"
        app:layout_constraintBottom_toTopOf="@id/myProfileBottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyProfileSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="88dp"
                        android:layout_height="116dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false">
                        <ImageView
                            android:id="@+id/ivMyProfileAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_home_avatar"
                            android:scaleType="centerCrop"
                            android:src="@drawable/discovery_profile_placeholder" />
                    </androidx.cardview.widget.CardView>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvMyProfileName"
                            style="@style/AuthCardTitle"
                            android:text="@string/profile_home_name"
                            android:textSize="21sp" />
                        <TextView
                            android:id="@+id/tvMyProfileAgeGender"
                            style="@style/AuthCardSubtitle"
                            android:layout_marginTop="4dp"
                            android:text="@string/profile_home_age_gender" />
                        <TextView
                            android:id="@+id/tvMyProfileMeasurements"
                            style="@style/AuthCardSubtitle"
                            android:layout_marginTop="4dp"
                            android:text="@string/profile_home_measurements"
                            android:textColor="@color/brand_primary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMyProfileEdit"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/profile_home_edit"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:backgroundTint="@color/brand_primary"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_profile_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMyProfilePreview"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/profile_home_preview"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_profile_eye"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_primary"
                    app:strokeColor="@color/border_input" />
            </LinearLayout>
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_marginTop="12dp"
                android:text="@string/profile_home_about" />
            <TextView
                android:id="@+id/tvMyProfileBio"
                style="@style/AuthCardSubtitle"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/profile_home_bio" />
            <TextView
                android:id="@+id/tvMyProfileLocation"
                style="@style/AuthCardSubtitle"
                android:layout_marginTop="8dp"
                android:text="@string/profile_home_location"
                android:textSize="12sp" />
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_marginTop="16dp"
                android:text="@string/profile_home_interests" />
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/tagMyProfileTravel"
                    style="@style/ProfileInterestTagSelected"
                    android:minHeight="32dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/profile_home_travel" />
                <TextView
                    android:id="@+id/tagMyProfileCoffee"
                    style="@style/ProfileInterestTagSelected"
                    android:minHeight="32dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/profile_home_coffee" />
                <TextView
                    android:id="@+id/tagMyProfileMusic"
                    style="@style/ProfileInterestTagSelected"
                    android:minHeight="32dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/profile_home_music" />
                <TextView
                    android:id="@+id/tagMyProfileFood"
                    style="@style/ProfileInterestTagSelected"
                    android:minHeight="32dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="@string/profile_home_food" />
                <androidx.constraintlayout.helper.widget.Flow
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:constraint_referenced_ids="tagMyProfileTravel,tagMyProfileCoffee,tagMyProfileMusic,tagMyProfileFood"
                    app:flow_wrapMode="chain"
                    app:flow_horizontalStyle="packed"
                    app:flow_horizontalBias="0"
                    app:flow_horizontalGap="6dp"
                    app:flow_verticalGap="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyProfileSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp">
                    <LinearLayout
                        android:id="@+id/rowMyProfileSettings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_profile_settings" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/profile_home_settings" />
                            <TextView
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="4dp"
                                android:text="@string/profile_home_settings_summary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="48dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowMyProfilePrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_profile_shield" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/profile_home_privacy" />
                            <TextView
                                style="@style/AuthCardSubtitle"
                                android:layout_marginTop="4dp"
                                android:text="@string/profile_home_privacy_summary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="48dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowMyProfileHelp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="64dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            android:src="@drawable/ic_profile_help" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/profile_home_help" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/myProfileBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@color/discovery_navigation_background"
        app:backgroundTint="@color/discovery_navigation_background"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/discovery_navigation_icon"
        app:itemTextColor="@color/discovery_navigation_icon"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/profile_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no"
        android:background="@color/brand_primary"
        app:layout_constraintEnd_toEndOf="@id/myProfileBottomNavigation"
        app:layout_constraintTop_toTopOf="@id/myProfileBottomNavigation" />
    <View
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginTop="14dp"
        android:translationX="7dp"
        android:background="@drawable/bg_circle_add"
        android:importantForAccessibility="no"
        app:layout_constraintHorizontal_bias="0.375"
        app:layout_constraintStart_toStartOf="@id/myProfileBottomNavigation"
        app:layout_constraintEnd_toEndOf="@id/myProfileBottomNavigation"
        app:layout_constraintTop_toTopOf="@id/myProfileBottomNavigation" />
</androidx.constraintlayout.widget.ConstraintLayout>