<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/filters_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">
    <LinearLayout
        android:id="@+id/settingsHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnSettingsBack"
            style="@style/AuthBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_photo_viewer_back"
            app:tint="@color/brand_primary" />
        <TextView
            style="@style/AuthCardTitle"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/profile_home_settings"
            android:textSize="20sp" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_input" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_marginTop="18dp"
                android:text="@string/settings_account"
                android:textSize="15sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:id="@+id/rowSettingsLogin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_discovery_person"
                            app:tint="@color/brand_primary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_login_info"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/settings_login_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_settings_key"
                            app:tint="@color/brand_primary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_password"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsDevices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_settings_device"
                            app:tint="@color/brand_primary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_devices"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_marginTop="18dp"
                android:text="@string/profile_edit_dating_preferences"
                android:textSize="15sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsDating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <TextView
                        style="@style/AuthFieldLabel"
                        android:layout_marginTop="16dp"
                        android:text="@string/filters_gender"
                        android:textSize="13sp" />
                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupSettingsGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        app:checkedButton="@id/btnSettingsWomen">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsWomen"
                            style="@style/FiltersGenderButton"
                            android:text="@string/filters_women" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsMen"
                            style="@style/FiltersGenderButton"
                            android:text="@string/filters_men" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSettingsEveryone"
                            style="@style/FiltersGenderButton"
                            android:text="@string/filters_everyone" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/AuthFieldLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_distance"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvSettingsDistanceValue"
                            style="@style/FiltersRangeValue"
                            android:text="@string/filters_distance_value" />
                    </LinearLayout>
                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSettingsDistance"
                        style="@style/FiltersSlider"
                        android:contentDescription="@string/filters_distance"
                        android:valueFrom="1"
                        android:valueTo="100"
                        android:stepSize="1"
                        android:value="40" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_distance_min" />
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:text="@string/filters_distance_max" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            style="@style/AuthFieldLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_age"
                            android:textSize="13sp" />
                        <TextView
                            android:id="@+id/tvSettingsAgeValue"
                            style="@style/FiltersRangeValue"
                            android:text="@string/filters_age_value" />
                    </LinearLayout>
                    <com.google.android.material.slider.RangeSlider
                        android:id="@+id/sliderSettingsAge"
                        style="@style/FiltersSlider"
                        android:contentDescription="@string/filters_age"
                        android:valueFrom="18"
                        android:valueTo="60"
                        android:stepSize="1"
                        app:values="@array/filters_age_initial_values" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/filters_age_min" />
                        <TextView
                            style="@style/FiltersRangeLimit"
                            android:text="@string/filters_age_max" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsAdvancedFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_advanced_filters"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/settings_advanced_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/ProfileEditHint"
                android:text="@string/settings_dating_hint" />
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_marginTop="18dp"
                android:text="@string/settings_experience"
                android:textSize="15sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsExperience"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:id="@+id/rowSettingsNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_settings_notification"
                            app:tint="@color/brand_primary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_notifications"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsPrivacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_profile_shield"
                            app:tint="@color/brand_primary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/profile_home_privacy"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/n_bg_age"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_settings_language"
                            app:tint="@color/brand_primary" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_language"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvSettingsLanguageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/settings_language_value"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/ProfileSectionTitle"
                android:layout_marginTop="18dp"
                android:text="@string/settings_support"
                android:textSize="15sp" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:id="@+id/rowSettingsHelpCenter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_help_center"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsContact"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_contact"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_input" />
                    <LinearLayout
                        android:id="@+id/rowSettingsTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_terms"
                                android:textSize="14sp"
                                android:textStyle="normal" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingsLogout"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="@string/settings_logout"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                app:backgroundTint="@color/white"
                app:cornerRadius="14dp"
                app:strokeColor="@color/border_input"
                app:icon="@drawable/ic_settings_logout"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                app:iconTint="@color/brand_primary" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSettingsDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_input"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp">
                    <LinearLayout
                        android:id="@+id/rowSettingsDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/AuthFieldLabel"
                                android:text="@string/settings_delete_account"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:textColor="@color/brand_primary" />
                            <TextView
                                style="@style/ProfileEditHint"
                                android:layout_marginTop="4dp"
                                android:text="@string/settings_delete_summary" />
                        </LinearLayout>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:rotation="180"
                            app:srcCompat="@drawable/ic_back"
                            app:tint="@color/brand_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>